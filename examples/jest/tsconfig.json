{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // "ESNext.Disposable" is what makes `await using driver = ...` compile.
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["node", "jest"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["test", "jest.config.js"]
}
