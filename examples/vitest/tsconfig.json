{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // "ESNext.Disposable" is what makes `await using driver = ...` compile.
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["test", "vitest.config.ts"]
}
